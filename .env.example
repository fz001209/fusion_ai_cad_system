# Copy this file to ".env" (same folder) and fill in your own values.
# Do NOT commit .env to source control.

# OpenAI-compatible API key (required for natural-language requirements and visual agents)
OPENAI_API_KEY=sk-your-api-key

# Optional: override base URL for OpenAI-compatible providers
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: default model name
OPENAI_MODEL=gpt-4o-mini
